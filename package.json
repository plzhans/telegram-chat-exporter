    "libphonenumber-js": "^1.13.12",
    "lucide-react": "^1.43.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.87.0",
